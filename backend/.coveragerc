[run]
branch = True
source =
    recipes
    config
omit =
    */migrations/*
    */tests/*
    */admin.py
    */apps.py
    */asgi.py
    */wsgi.py
    manage.py

[report]
show_missing = True
skip_empty = True
precision = 2
fail_under = 60
exclude_also =
    pragma: no cover
    if TYPE_CHECKING:
    if __name__ == "__main__":

[html]
directory = coverage_html
title = Backend coverage report

[xml]
output = coverage.xml